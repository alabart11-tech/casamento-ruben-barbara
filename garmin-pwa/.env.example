# Garmin Connect API credentials
# Obtém em: https://developer.garmin.com/connect-app/registration/
GARMIN_CONSUMER_KEY=your_consumer_key_here
GARMIN_CONSUMER_SECRET=your_consumer_secret_here

# URL da tua app (local ou produção)
APP_URL=http://localhost:3000

# Chave secreta para sessões (qualquer string aleatória)
SESSION_SECRET=muda-esta-chave-para-algo-aleatorio

PORT=3000
